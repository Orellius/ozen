{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orellius STT",
  "version": "0.1.0",
  "identifier": "ai.orellius.stt",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orellius STT",
        "width": 480,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Whissper Local",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
