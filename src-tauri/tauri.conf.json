{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ozen",
  "version": "0.5.1",
  "identifier": "ai.orellius.ozen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ozen",
        "width": 560,
        "height": 760,
        "minWidth": 440,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "",
        "width": 104,
        "height": 104,
        "minWidth": 72,
        "minHeight": 72,
        "maxWidth": 900,
        "maxHeight": 480,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "closable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Whissper Local",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
