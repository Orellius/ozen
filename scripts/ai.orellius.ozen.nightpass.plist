<?xml version="1.0" encoding="UTF-8"?>
<!--
  The night pass, scheduled. NOT INSTALLED - wiring a LaunchAgent is a contract change and is
  Orel's call, never bundled silently into feature work.

  IT CANNOT RUN THE SCRIPT OUT OF THE REPO. Measured 2026-08-08 by kickstarting it: the job fired
  (runs = 1) and exited 2 with "Operation not permitted" reading the script. A launchd-spawned
  process is disclaimed and holds no TCC grant for ~/Desktop, ~/Documents or ~/Downloads - this is
  SCAR-006, and it is why the path above points at a DEPLOYED COPY. The repo stays source of truth;
  ~/.ozen/ is the copy launchd is permitted to read. RE-DEPLOY THAT COPY after every change to
  scripts/night-pass.py, or the nightly job quietly keeps running the old one.

  EVERY __HOME__ AND __USER__ BELOW MUST BE SUBSTITUTED BEFORE INSTALLING. launchd does not
  expand ~, $HOME or any variable inside this file - a literal path is the only thing that
  works, which is why this ships as a template rather than as a ready file. The sed line in
  the install steps does the substitution; doing it by hand is equally fine, and forgetting
  it entirely produces a job that loads and fails silently at 5am.

  To install (the first line is the deploy step, and it is not optional):
      mkdir -p ~/.ozen && cp scripts/night-pass.py ~/.ozen/night-pass.py
      sed -e "s|__HOME__|$HOME|g" -e "s|__USER__|$(id -un)|g" \
          scripts/ai.orellius.ozen.nightpass.plist \
          > ~/Library/LaunchAgents/ai.orellius.ozen.nightpass.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.orellius.ozen.nightpass.plist
  To remove:
      launchctl bootout gui/$(id -u)/ai.orellius.ozen.nightpass
      rm ~/Library/LaunchAgents/ai.orellius.ozen.nightpass.plist
  To run once by hand, which needs no installation at all:
      python3 scripts/night-pass.py

  05:00 is deliberate: it is after he has stopped for the night on the pattern in his own log, and
  the pass only reads log.json and writes a proposals file, so it cannot disturb a running app. The
  app picks the proposals up at its next startup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.orellius.ozen.nightpass</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/.ozen/night-pass.py</string>
        <string>--limit</string>
        <string>80</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Never wake the machine for this; a missed night simply means a bigger batch tomorrow. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/ai.orellius.ozen/night-pass.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/ai.orellius.ozen/night-pass.log</string>

    <!--
      MEASURED 2026-08-08, and this block is the difference between a pass that runs and one that
      fails silently at 5am. With PATH and HOME alone, `claude -p` exits 1 with the misleading
      message "Credit balance is too low" - it cannot resolve the user identity, and nothing in
      that error hints at the cause. Bisected: adding USER, LOGNAME and SHELL makes it exit 0.
      Verified by running the real script under `env -i` with exactly these variables.
      (Locale is NOT needed - python3 reports UTF-8 under an empty environment on this machine, so
      Hebrew round-trips; LANG is set anyway because that default is a macOS version away from
      changing and the failure would be a mangled dictionary.)
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd hands a minimal PATH; the Claude CLI lives in ~/.local/bin. -->
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>USER</key>
        <string>__USER__</string>
        <key>LOGNAME</key>
        <string>__USER__</string>
        <key>SHELL</key>
        <string>/bin/zsh</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
